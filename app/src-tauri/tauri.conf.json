{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clio Notes",
  "version": "0.1.0",
  "identifier": "com.clionotes.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Clio Notes",
        "width": 1040,
        "height": 760,
        "minWidth": 420,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Clio Notes",
    "category": "Productivity",
    "shortDescription": "Meeting notes with screenshots, written while the meeting happens",
    "longDescription": "Clio Notes records your microphone, your computer's sound and your screen, and writes meeting notes with screenshots as the meeting happens, using your own AI provider keys.",
    "copyright": "Copyright 2026 Clio Notes",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
